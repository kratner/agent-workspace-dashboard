{
  "name": "agent-workspace-dashboard",
  "displayName": "Agent Workspace Dashboard",
  "description": "See every Claude Code session you have running, as a Kanban board or a list, and spot the one that's waiting on you.",
  "version": "0.5.1",
  "publisher": "kratner",
  "author": {
    "name": "Keith Ratner",
    "url": "https://github.com/kratner"
  },
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "homepage": "https://github.com/kratner/agent-workspace-dashboard#readme",
  "bugs": {
    "url": "https://github.com/kratner/agent-workspace-dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kratner/agent-workspace-dashboard.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "ai",
    "sessions",
    "kanban",
    "dashboard"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentWorkspace.dashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentWorkspace.openDashboard",
        "title": "Open Dashboard",
        "category": "Agent Workspace",
        "icon": "$(layout)"
      },
      {
        "command": "agentWorkspace.refresh",
        "title": "Refresh Sessions",
        "category": "Agent Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentWorkspace.checkForUpdates",
        "title": "Check for Updates",
        "category": "Agent Workspace"
      }
    ],
    "configuration": {
      "title": "Agent Workspace",
      "properties": {
        "agentWorkspace.appearance": {
          "type": "string",
          "enum": [
            "brand",
            "vscode"
          ],
          "enumDescriptions": [
            "KR brand: black panel, yellow for sessions waiting on you, Archivo type.",
            "Follow the current VS Code color theme (keeps the KR mark and type)."
          ],
          "default": "brand",
          "description": "How the dashboard looks."
        },
        "agentWorkspace.endedWithinHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "Show ended sessions whose last activity was within this many hours. 0 hides ended sessions."
        },
        "agentWorkspace.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item with the number of working and waiting sessions."
        },
        "agentWorkspace.historyResultThreshold": {
          "type": "number",
          "default": 150,
          "minimum": 100,
          "maximum": 200,
          "description": "History search: above this many matching past sessions, show the 25 most recent first, with a button to show them all."
        },
        "agentWorkspace.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "About once a day, ask GitHub whether a newer release of this extension exists, and offer to install it. This is the only network request the extension makes. Turn it off if you installed from the Marketplace, which updates extensions itself."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit && tsc -p test --noEmit",
    "production": "npm run typecheck && node esbuild.mjs --production",
    "vscode:prepublish": "npm run production",
    "package": "vsce package --no-dependencies",
    "brand": "node branding/render.mjs",
    "brand:compare": "node branding/compare.mjs",
    "test": "node test/run.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
